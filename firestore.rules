rules_version = '2';

// Each signed-in user can read and write only their own saved trails.
// Everything else is closed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/trails/{trailId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['steps', 'savedAt'])
        && request.resource.data.steps is list
        && request.resource.data.steps.size() >= 2
        && request.resource.data.steps.size() <= 200
        && request.resource.data.savedAt is number;
    }
  }
}
